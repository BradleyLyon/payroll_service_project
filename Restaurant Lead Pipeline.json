      "typeVersion": 1,
      "position": [
        608,
        576
      ]
    },
    {
      "parameters": {
        "content": "## Stage 4 — Validate + Email\nScore each lead, collect successes + errors, send one summary sorted by score.",
        "height": 240,
        "width": 480,
        "color": 7
      },
      "id": "79d6265f-13ff-4834-a2ea-7724bb8da825",
      "name": "Stage 4",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1472,
        640
      ]
    },
    {
      "parameters": {},
      "id": "270d1349-436f-4988-ae49-865898de828f",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        304
      ]
    },
    {
      "parameters": {
        "url": "https://data.cityofnewyork.us/resource/43nn-pn8j.json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "$where",
              "value": "=building='{{ $json.Address1.split(\" \")[0] }}' AND zipcode='{{ String($json.ZIP).slice(0,5) }}'"
            },
            {
              "name": "$select",
              "value": "camis,dba,phone,inspection_date,bin,bbl"
            },
            {
              "name": "$limit",
              "value": "1"
            },
            {
              "name": "$order",
              "value": "inspection_date DESC"
            }
          ]
        },
        "options": {}
      },
      "id": "4a080487-725a-4a02-ba7e-8da93bf9ef84",
      "name": "Enrich - HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1024,
        304
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a lead qualification analyst for a payroll/payment-processing sales pipeline targeting independent NYC restaurants.\n\nAnalyze ONLY the data provided below. Do not invent facts. If something cannot be determined from the data, write \"unknown\".\n\nLEAD DATA:\n- Applicant (SLA pending license): {{ $json.premise_name }} / DBA: {{ $json.premise_dba }}\n- Address: {{ $json.address }}, ZIP {{ $json.zip }}\n- License category: {{ $json.category }}\n- Principals: {{ $json.principals }}\n- DOHMH record at this address: DBA \"{{ $json.dba }}\", phone {{ $json.phone }}, last inspection {{ $json.inspection_date }}, CAMIS {{ $json.camis }}\n\nCLASSIFICATION RULES:\n- If DOHMH DBA differs meaningfully from the SLA applicant DBA → segment S1 (likely ownership change at an operating venue; highest priority).\n- If DOHMH DBA matches the applicant → operating venue adding/renewing a license; segment S2.\n- If inspection_date is 1900-01-01 → registered but never inspected; likely pre-open; segment S3.\n- Chain or franchise names → mark is_independent false.\n\nRespond with ONLY this JSON, no other text:\n{\n  \"segment\": \"S1|S2|S3\",\n  \"is_independent\": true/false,\n  \"dba_mismatch\": true/false,\n  \"signal_summary\": \"2-3 sentences on why this lead matters and what changed\",\n  \"contact_name\": \"from principals, formatted First Last, or unknown\",\n  \"contact_phone\": \"from DOHMH phone, or unknown\",\n  \"needs_human_verification\": [\"list of specific things to check manually, e.g. website, online ordering, current POS\"],\n  \"confidence\": \"high|medium|low\"\n}",
        "options": {
          "systemMessage": "You are a restaurant lead research assistant. Return plain text only."
        }
      },
      "id": "f2cb9194-daea-4ea4-815d-e7ea5b4f6f64",
      "name": "AI Research",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1792,
        160
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "gpt-5-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "b87fad45-799a-42e7-86bb-933468577005",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1808,
        336
      ],
      "credentials": {
        "openAiApi": {
          "id": "qOcYhqiUMSLBpk3P",
          "name": "n8n free OpenAI API credits"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Parse the AI's JSON (it arrives as a string in \"output\")\nlet ai;\ntry {\n  ai = JSON.parse($json.output);\n} catch (e) {\n  return { json: { parse_error: true, raw: $json.output } };\n}\n\n// Pull original lead fields from the merge node\nconst lead = $('Merge Lead + DOHMH').item.json;\n\n// Score: segment base + signal bonuses\nlet score = 0;\nif (ai.segment === \"S1\") score += 5;\nelse if (ai.segment === \"S2\") score += 3;\nelse if (ai.segment === \"S3\") score += 2;\n\nif (ai.is_independent) score += 2;\nif (ai.contact_phone && ai.contact_phone !== \"unknown\") score += 1;\nif (ai.contact_name && ai.contact_name !== \"unknown\") score += 1;\nif (ai.confidence === \"high\") score += 1;\n\nreturn {\n  json: {\n    premise_name: lead.premise_name,\n    premise_dba: lead.premise_dba,\n    address: lead.address,\n    zip: lead.zip,\n    category: lead.category,\n    segment: ai.segment,\n    score: score,\n    is_independent: ai.is_independent,\n    dba_mismatch: ai.dba_mismatch,\n    contact_name: ai.contact_name,\n    contact_phone: ai.contact_phone,\n    signal_summary: ai.signal_summary,\n    needs_verification: (ai.needs_human_verification || []).join(\"; \"),\n    confidence: ai.confidence,\n    camis: lead.camis,\n    dohmh_dba: lead.dba\n  }\n};item;"
      },
      "id": "c476f468-e9d2-47d4-ba4d-a17b2ecf2c2b",
      "name": "Validate + Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        32
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "numberInputs": 5
      },
      "id": "1a5ce48c-d596-4e55-ae80-ab97ca72ecfa",
      "name": "Collect Results + Errors",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        2304,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const LF = String.fromCharCode(10);\nconst leads = $input.all().map(i => i.json).sort((a, b) => (b.score || 0) - (a.score || 0));\n\nlet body = \"RESTAURANT LEAD REPORT — \" + new Date().toLocaleDateString(\"en-US\") + LF;\nbody += leads.length + \" leads, ranked by score\" + LF;\nbody += \"========================================\" + LF + LF;\n\nfor (const l of leads) {\n  body += \"[\" + (l.segment || \"?\") + \" | SCORE \" + (l.score ?? \"?\") + \"] \" + (l.premise_dba || l.premise_name) + LF;\n  body += \"Entity: \" + (l.premise_name || \"unknown\") + LF;\n  body += \"Address: \" + (l.address || \"?\") + \", \" + (l.zip || \"\") + LF;\n  body += \"License: \" + (l.category || \"unknown\") + LF;\n  body += \"Contact: \" + (l.contact_name || \"unknown\") + \" — \" + (l.contact_phone || \"no phone\") + LF;\n  if (l.dba_mismatch) body += \"⚠ OWNERSHIP CHANGE SIGNAL: DOHMH shows '\" + (l.dohmh_dba || \"?\") + \"' at this address\" + LF;\n  body += LF + \"Why it matters: \" + (l.signal_summary || \"n/a\") + LF;\n  body += \"Verify manually: \" + (l.needs_verification || \"n/a\") + LF;\n  body += \"Confidence: \" + (l.confidence || \"?\") + LF;\n  body += \"----------------------------------------\" + LF + LF;\n}\n\nreturn [{ json: { emailBody: body, subject: \"Lead Pipeline: \" + leads.length + \" scored leads (\" + new Date().toLocaleDateString(\"en-US\") + \")\" } }];"
      },
