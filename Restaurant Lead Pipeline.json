{
  "name": "Restaurant Lead Pipeline",
  "nodes": [
    {
      "parameters": {
        "content": "## Stage 1 — Pull SLA Pending\nManual trigger pulls pending liquor-license applications (NYC counties) from the NY State SLA dataset as JSON.",
        "height": 220,
        "width": 420,
        "color": 7
      },
      "id": "7770cc25-777b-4a2b-b79b-c1358aff71ef",
      "name": "Stage 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        48,
        576
      ]
    },
    {
      "parameters": {
        "content": "## Stage 2 — Enrich (per lead)\nHTTP GET with per-item URL, then a Code node. Errors route to the summary email.",
        "height": 220,
        "width": 420,
        "color": 7
      },
      "id": "88267610-2562-49ad-abe0-cb5dee3a3f99",
      "name": "Stage 2",
